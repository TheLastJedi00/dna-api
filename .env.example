# ---- Servidor ----
PORT=8080
# Origens permitidas no CORS (separar por vírgula). Vazio = CORS desabilitado.
# Produção: https://dna-empresaria.vercel.app
# Local:    http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200

# ---- Firebase (obrigatório) ----
# JSON da service account em base64.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Auth ----
# Sessão é do Firebase Auth (spec 010): o front entra pelo SDK web e a API valida
# o ID token com a mesma service account acima. Sem segredos JWT próprios.

# ---- Gemini (obrigatório) ----
GEMINI_API_KEY=
# Modelo do Gemini. Padrão: gemini-3-flash-preview.
GEMINI_MODEL=gemini-3-flash-preview

# ---- Redis (opcional) ----
# Sem REDIS_URL a API roda em modo degradado (sem cache e sem rate-limit
# distribuído). Local (docker-compose): redis://localhost:6379
REDIS_URL=
