# ---- Servidor ----
PORT=8080
# Origens permitidas no CORS (separar por vírgula). Vazio = CORS desabilitado.
# Produção: https://dna-empresaria.vercel.app
# Local:    http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200

# ---- Firebase (obrigatório) ----
# JSON da service account em base64.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- JWT ----
JWT_SECRET=troque-me
# Segredo separado do refresh token (obrigatório para /auth/refresh e /auth/logout).
JWT_REFRESH_SECRET=troque-me-refresh
# Expiração do access token (ex.: 15m). Padrão: 15m.
JWT_ACCESS_EXPIRES=15m
# Expiração do refresh token no JWT (ex.: 7d). Padrão: 7d.
JWT_REFRESH_EXPIRES=7d
# TTL (segundos) da allowlist de refresh no Redis. Padrão: 604800 (7d).
JWT_REFRESH_TTL_SECONDS=604800

# ---- Gemini (obrigatório) ----
GEMINI_API_KEY=
# Modelo do Gemini. Padrão: gemini-3-flash-preview.
GEMINI_MODEL=gemini-3-flash-preview

# ---- Redis (opcional) ----
# Sem REDIS_URL a API roda em modo degradado (sem cache/rate-limit distribuído/
# allowlist de refresh). Local (docker-compose): redis://localhost:6379
REDIS_URL=
